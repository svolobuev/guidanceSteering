<?xml version="1.0" encoding="utf-8"?>
<GUI name="guidanceSteeringStrategy">
  <GuiElement profile="gs25_panel" id="container">
    <Text profile="gs25_heading" text="$l10n_guidanceSteering_setting_strategy" />
    <Text profile="gs25_label" position="0px -65px" size="400px 36px" text="$l10n_guidanceSteering_setting_strategy" />
    <MultiTextOption profile="gs25_option" position="0px -110px" size="400px 36px" id="guidanceSteeringStrategyElement" />
    <Text profile="gs25_label" position="0px -175px" size="400px 36px" text="$l10n_guidanceSteering_setting_strategyMethod" />
    <MultiTextOption profile="gs25_option" position="0px -220px" size="400px 36px" id="guidanceSteeringStrategyMethodElement" onClick="onStrategyChanged" />
    <Button profile="gs25_button" position="0px -305px" size="400px 44px" text="$l10n_guidanceSteering_setting_pointA" id="guidanceSteeringPointAButton" onClick="onClickSetPointA" />
    <Button profile="gs25_button" position="0px -370px" size="400px 44px" text="$l10n_guidanceSteering_setting_pointB" id="guidanceSteeringPointBButton" onClick="onClickSetPointB" />
    <Text profile="gs25_label" position="475px -65px" size="430px 36px" text="$l10n_ui_savegameName" />
    <TextInput profile="gs25_input" position="475px -110px" id="guidanceSteeringTrackNameElement" maxCharacters="30" toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_toolTip_savegameName" />
    <Text profile="gs25_label" position="475px -175px" size="430px 36px" text="$l10n_guidanceSteering_setting_scopeTrackFarmId" />
    <CheckedOption profile="gs25_option" position="475px -220px" id="guidanceSteeringScopeFarmIdElement" toolTipElementId="settingsHelpBoxText" toolTipText="$l10n_guidanceSteering_tooltip_scopeTrackFarmId" />
    <Button profile="gs25_button" position="475px -305px" size="430px 44px" text="$l10n_guidanceSteering_setting_newTrack" id="guidanceSteeringCreateTrackButton" onClick="onClickCreateTrack" />
    <Button profile="gs25_button" position="475px -370px" size="430px 44px" text="$l10n_guidanceSteering_setting_saveTrack" id="guidanceSteeringSaveTrackButton" onClick="onClickSaveTrack" />
    <Button profile="gs25_button" position="475px -435px" size="430px 44px" text="$l10n_guidanceSteering_setting_removeTrack" id="guidanceSteeringRemoveTrackButton" onClick="onClickRemoveTrack" />
    <Button profile="gs25_button" position="475px -500px" size="430px 44px" text="$l10n_input_GS_ROTATE_TRACK" id="guidanceSteeringRotateTrackButton" onClick="onClickRotateTrack" />
    <Text profile="gs25_label" position="985px -65px" size="465px 36px" text="$l10n_guidanceSteering_setting_currentTrack" />
    <SmoothList profile="gs25_trackList" position="985px -110px" id="list" onSelectionChanged="onListSelectionChanged" onClick="onClickSelect" onDoubleClick="onClickSelect">
      <ListItem profile="gs25_trackItem" id="listItemTemplate">
        <Text profile="gs25_trackTitle" name="title" />
      </ListItem>
    </SmoothList>
    <Text profile="gs25_help" id="settingsHelpBoxText" position="0px -750px" text="" />
  </GuiElement>
</GUI>
